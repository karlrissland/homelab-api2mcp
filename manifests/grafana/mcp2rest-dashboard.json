{
  "uid": "mcp2rest-overview",
  "title": "mcp2rest Overview",
  "tags": ["mcp2rest", "mcp", "homelab"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "app",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(mcp2rest_tool_requests_total, app)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "sum by (app, outcome) (rate(mcp2rest_tool_requests_total{app=~\"$app\"}[5m]))",
          "legendFormat": "{{app}} {{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "expr": "sum(rate(mcp2rest_tool_requests_total{app=~\"$app\", outcome!=\"success\"}[5m])) / clamp_min(sum(rate(mcp2rest_tool_requests_total{app=~\"$app\"}[5m])), 0.001)",
          "legendFormat": "error rate"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latency p50",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, app) (rate(mcp2rest_tool_request_duration_seconds_bucket{app=~\"$app\"}[5m])))",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Latency p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, app) (rate(mcp2rest_tool_request_duration_seconds_bucket{app=~\"$app\"}[5m])))",
          "legendFormat": "{{app}}"
        }
      ]
    }
  ]
}
